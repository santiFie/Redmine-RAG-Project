# ==============================================================================
# BFF (Backend for Frontend) — Variables de Entorno
# Copiar a .env y ajustar los valores antes de iniciar
# ==============================================================================

# Servidor
PORT=8000

# JWT
SECRET_KEY=cambia_esta_clave_secreta_jwt_en_produccion_min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LangGraph Platform
LANGGRAPH_API_URL=http://langgraph-api:8123
LANGGRAPH_GRAPH_ID=redmine_agent
# Dejar vacío si el dev server de LangGraph no usa API key
LANGGRAPH_API_KEY=

# CORS — orígenes permitidos separados por comas
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80,http://localhost
