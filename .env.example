# ==============================================================================
# .env.example — Variables de entorno del proyecto
# Copiar a .env y completar con valores reales:  cp .env.example .env
# NUNCA commitear el archivo .env real al repositorio.
# ==============================================================================

# ------------------------------------------------------------------------------
# REDMINE
# ------------------------------------------------------------------------------
REDMINE_URL=http://localhost:3000          # URL de la instancia Redmine
REDMINE_API_KEY=your_redmine_api_key_here  # Generada en Perfil → API access key
REDMINE_PORT=3000                          # Puerto expuesto en docker-compose
REDMINE_DEFAULT_PROJECT=test-project       # Identificador del proyecto por defecto

# Redmine Database (PostgreSQL)
REDMINE_DB_NAME=redmine
REDMINE_DB_USER=redmine
REDMINE_DB_PASSWORD=redmine_secret
REDMINE_SECRET_KEY_BASE=change_this_to_a_long_random_string_in_production

# ------------------------------------------------------------------------------
# LLM PROVIDERS — Completar los proveedores necesarios
# ------------------------------------------------------------------------------

# Groq (Requerido por defecto en los nodos principales del grafo LangGraph)
GROQ_API_KEY=gsk_...

# NVIDIA NIM (Utilizado en fallback y en nodo de respuesta general)
NVIDIA_API_KEY=nvapi-...

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (modelos locales — no requiere API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2                      # nombre del modelo local

# Hugging Face (requerido si EMBEDDING_PROVIDER=hf_api o para RAGAS)
HUGGINGFACE_API_KEY=hf_...

# Modelo a usar (groq | nvidia | openrouter | openai | anthropic | ollama)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Modelo de embeddings (local | hf_api | openai | ollama)s
# - local: ejecuta BAAI/bge-m3 en tu máquina (sin llamadas de red, sin 504 timeouts)
# - hf_api: usa la Serverless Inference API de Hugging Face
EMBEDDING_PROVIDER=local
EMBED_MODEL=BAAI/bge-m3

# ------------------------------------------------------------------------------
# QDRANT (Vector DB)
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                            # Dejar vacío si no hay autenticación
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=redmine_docs        # Nombre de la colección RAG

# ------------------------------------------------------------------------------
# LANGSMITH / LANGCHAIN PLATFORM
# ------------------------------------------------------------------------------
LANGCHAIN_API_KEY=ls__...                  # LangSmith API Key (trazabilidad)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=redmine-langgraph-rag

# LangGraph Platform (self-hosted)
LANGGRAPH_PORT=8123                        # Puerto local del servidor LangGraph

# ------------------------------------------------------------------------------
# CHECKPOINTING (Postgres — para persistencia de estado del grafo)
# Puede reutilizar la misma BD de Redmine o una independiente
# ------------------------------------------------------------------------------
POSTGRES_URI=postgresql://redmine:redmine_secret@localhost:5432/redmine

# ------------------------------------------------------------------------------
# PGADMIN
# ------------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# ------------------------------------------------------------------------------
# APLICACIÓN
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR
ENVIRONMENT=development                    # development | production
